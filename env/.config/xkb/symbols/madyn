// Real Programmers Dvorak — Madyn (personal)
//
// Saved as either one:
//   • ~/.config/xkb/symbols/madyn        # per-user
//   • /usr/share/X11/xkb/symbols/madyn   # system-wide
//
// Section: xkb_symbols "real_prog_dvorak"
// Base:    include "us(basic)"   |   Scope: partial alphanumeric_keys
//
// Verify:
//   SYS_XKB="$(pkg-config --variable=xkb_base xkeyboard-config)"
//   xkbcli compile-keymap --rules evdev --model pc105 \
//     --layout madyn --variant real_prog_dvorak \
//     --include "$SYS_XKB" --include "$HOME/.config/xkb" >/dev/null && echo OK
//
// Hyprland:
//   input { kb_layout = madyn; kb_variant = real_prog_dvorak; }
//
// Apply:
//   hyprctl reload
//
partial alphanumeric_keys
xkb_symbols "real_prog_dvorak" {
    include "us(basic)"

    name[Group1] = "English (Real Programmers Dvorak)";

    // TLDE row
    key <TLDE> { [ dollar, asciitilde, dead_grave, dead_tilde ] };

    // Number row (AE01..AE12)
    key <AE01> { [ plus,          1 ] };
    key <AE02> { [ bracketleft,   2 ] };
    key <AE03> { [ braceleft,     3 ] };
    key <AE04> { [ parenleft,     4 ] };
    key <AE05> { [ ampersand,     5 ] };
    key <AE06> { [ equal,         6, dead_circumflex, dead_circumflex ] };
    key <AE07> { [ parenright,    7 ] };
    key <AE08> { [ braceright,    8 ] };
    key <AE09> { [ bracketright,  9, dead_grave ] };
    key <AE10> { [ asterisk,      0 ] };
    key <AE11> { [ exclam,    percent ] };
    key <AE12> { [ bar,         grave, dead_tilde ] };

    // Top alpha row (AD01..AD12)
    key <AD01> { [ semicolon, colon, dead_acute, dead_diaeresis ] };
    key <AD02> { [ comma,     less,  dead_cedilla, dead_caron ] };
    key <AD03> { [ period,    greater, dead_abovedot, periodcentered ] };
    key <AD04> { [ p,         P ] };
    key <AD05> { [ y,         Y ] };
    key <AD06> { [ f,         F ] };
    key <AD07> { [ g,         G ] };
    key <AD08> { [ c,         C ] };
    key <AD09> { [ r,         R ] };
    key <AD10> { [ l,         L ] };
    key <AD11> { [ slash, question ] };
    key <AD12> { [ at,    asciicircum ] };

    // Home row (AC01..AC11)
    key <AC01> { [ a, A ] };
    key <AC02> { [ o, O ] };
    key <AC03> { [ e, E ] };
    key <AC04> { [ u, U ] };
    key <AC05> { [ i, I ] };
    key <AC06> { [ d, D ] };
    key <AC07> { [ h, H ] };
    key <AC08> { [ t, T ] };
    key <AC09> { [ n, N ] };
    key <AC10> { [ s, S ] };
    key <AC11> { [ minus, underscore ] };

    // Bottom row (AB01..AB10)
    key <AB01> { [ apostrophe, quotedbl, dead_ogonek, dead_doubleacute ] };
    key <AB02> { [ q, Q ] };
    key <AB03> { [ j, J ] };
    key <AB04> { [ k, K ] };
    key <AB05> { [ x, X ] };
    key <AB06> { [ b, B ] };
    key <AB07> { [ m, M ] };
    key <AB08> { [ w, W ] };
    key <AB09> { [ v, V ] };
    key <AB10> { [ z, Z ] };

    // Backslash key
    key <BKSL> { [ backslash, question] };
    key <LSGT> { [ less, numbersign ] };
    key <RTRN> { [ Return, Return, Return, Return ] };
};
